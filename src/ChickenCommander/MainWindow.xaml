<Window x:Class="ChickenCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChickenCommander.Views"
        xmlns:viewer="clr-namespace:ChickenCommander.Viewer"
        Title="Chicken Commander" Icon="/Assets/chicken.ico"
        Width="1200" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        Closing="Window_Closing">
    <!-- Menu items carry a command id in Tag; Command_Click runs it and the shortcut text is filled in from the
         (customizable) shortcut map, so menu, keyboard and button bar always agree. -->
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{DynamicResource ChromeBrush}" Padding="2">
            <MenuItem Header="_Files">
                <MenuItem Header="_View" Tag="View" Click="Command_Click" />
                <MenuItem Header="_Edit" Tag="Edit" Click="Command_Click" />
                <Separator />
                <MenuItem Header="Cut to clip_board" Tag="CutToClipboard" Click="Command_Click" />
                <MenuItem Header="Copy to c_lipboard" Tag="CopyToClipboard" Click="Command_Click" />
                <MenuItem Header="Pa_ste" Tag="Paste" Click="Command_Click" />
                <MenuItem Header="Explorer context menu" Tag="ContextMenu" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Copy..." Tag="Copy" Click="Command_Click" />
                <MenuItem Header="_Rename/Move..." Tag="Move" Click="Command_Click" />
                <MenuItem Header="Re_name in place..." Tag="Rename" Click="Command_Click" />
                <MenuItem Header="New _folder..." Tag="MakeDirectory" Click="Command_Click" />
                <MenuItem Header="_Delete" Tag="Delete" Click="Command_Click" />
                <MenuItem Header="Delete _permanently" Tag="DeletePermanently" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Pack..." Tag="Pack" Click="Command_Click" />
                <MenuItem Header="_Unpack..." Tag="Unpack" Click="Command_Click" />
                <MenuItem Header="Create chec_ksums..." Tag="CreateChecksums" Click="Command_Click" />
                <MenuItem Header="_Verify checksums" Tag="VerifyChecksums" Click="Command_Click" />
                <Separator />
                <MenuItem Header="Compare by con_tent..." Tag="CompareFiles" Click="Command_Click" />
                <MenuItem Header="_Multi-Rename tool..." Tag="MultiRename" Click="Command_Click" />
                <MenuItem Header="Change _attributes..." Tag="ChangeAttributes" Click="Command_Click" />
                <MenuItem Header="File _operations window" Tag="ShowOperations" Click="Command_Click" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Mark">
                <MenuItem Header="_Select group..." Tag="SelectGroup" Click="Command_Click" />
                <MenuItem Header="_Unselect group..." Tag="UnselectGroup" Click="Command_Click" />
                <MenuItem Header="Select _all" Tag="SelectAll" Click="Command_Click" />
                <MenuItem Header="Unselect a_ll" Tag="UnselectAll" Click="Command_Click" />
                <MenuItem Header="_Invert selection" Tag="InvertSelection" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="_Commands">
                <MenuItem Header="Fin_d files..." Tag="Search" Click="Command_Click" />
                <MenuItem Header="S_ynchronize directories..." Tag="SyncDirectories" Click="Command_Click" />
                <Separator />
                <MenuItem Header="Directory _hotlist" Tag="ShowHotlist" Click="Command_Click" />
                <MenuItem Header="Add current folder to hotlist..." Tag="AddToHotlist" Click="Command_Click" />
                <MenuItem Header="Folder hi_story" Tag="ShowHistory" Click="Command_Click" />
                <MenuItem Header="_Back" Tag="GoBack" Click="Command_Click" />
                <MenuItem Header="_Forward" Tag="GoForward" Click="Command_Click" />
                <Separator />
                <MenuItem Header="_Swap panels" Tag="SwapPanels" Click="Command_Click" />
                <MenuItem Header="_Target = Source" Tag="TargetEqualsSource" Click="Command_Click" />
                <MenuItem Header="Command _prompt here" Tag="CommandPrompt" Click="Command_Click" />
                <MenuItem Header="Open in _Explorer" Tag="Explorer" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="_Net">
                <MenuItem Header="_Connect to server (FTP / SFTP)..." Tag="Connect" Click="Command_Click" />
                <MenuItem Header="_Disconnect" Tag="Disconnect" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="_Tabs">
                <MenuItem Header="_New tab" Tag="NewTab" Click="Command_Click" />
                <MenuItem Header="Open folder in new _tab" Tag="OpenInNewTab" Click="Command_Click" />
                <MenuItem Header="_Close tab" Tag="CloseTab" Click="Command_Click" />
                <MenuItem Header="Ne_xt tab" Tag="NextTab" Click="Command_Click" />
                <MenuItem Header="_Previous tab" Tag="PreviousTab" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="_Show">
                <MenuItem Header="_Quick View panel" Tag="ToggleQuickView" Click="Command_Click"
                          IsCheckable="True" IsChecked="{Binding IsQuickView, Mode=OneWay}" />
                <MenuItem Header="_Hidden/system files" Tag="ToggleHidden" Click="Command_Click"
                          IsCheckable="True" IsChecked="{Binding ShowHidden, Mode=OneWay}" />
                <MenuItem Header="_Button bar" Click="ToggleButtonBar_Click" x:Name="ButtonBarMenuItem" IsCheckable="True" />
                <MenuItem Header="_Refresh" Tag="Refresh" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="C_onfiguration">
                <MenuItem Header="_Settings..." Tag="Settings" Click="Command_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Tag="Help" Click="Command_Click" />
                <MenuItem Header="_Project on GitHub" Click="GitHub_Click" />
                <MenuItem Header="_About Chicken Commander" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Button bar: built from settings in code-behind -->
        <Border x:Name="ButtonBarHost" DockPanel.Dock="Top" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <WrapPanel x:Name="ButtonBarPanel" />
        </Border>

        <!-- Function key bar -->
        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="2">
            <UniformGrid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <EventSetter Event="Click" Handler="Command_Click" />
                </Style>
            </UniformGrid.Resources>
            <Button Content="F3 View" Tag="View" />
            <Button Content="F4 Edit" Tag="Edit" />
            <Button Content="F5 Copy" Tag="Copy" />
            <Button Content="F6 Move" Tag="Move" />
            <Button Content="F7 NewFolder" Tag="MakeDirectory" />
            <Button Content="F8 Delete" Tag="Delete" />
            <Button Content="Alt+F4 Exit" Click="Exit_Click" Tag="" />
        </UniformGrid>

        <!-- Command line -->
        <DockPanel DockPanel.Dock="Bottom" Margin="4,2">
            <TextBlock Text="{Binding CommandPrompt}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource AccentTextBrush}"
                       MaxWidth="500" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="CommandLineBox" Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                     Padding="2" KeyDown="CommandLineBox_KeyDown" />
        </DockPanel>

        <Grid Margin="2,2,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:FilePanel x:Name="LeftPanel" Grid.Column="0" DataContext="{Binding Left}" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />
            <views:FilePanel x:Name="RightPanel" Grid.Column="2" DataContext="{Binding Right}" />

            <!-- Quick View (Ctrl+Q): replaces the inactive panel -->
            <DockPanel x:Name="LeftQuickHost" Grid.Column="0" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Quick View  (Ctrl+Q to close)" Padding="4,3" Background="{DynamicResource PanelHeaderInactiveBrush}" Foreground="{DynamicResource PanelHeaderInactiveTextBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="LeftQuickInfo" DockPanel.Dock="Bottom" Padding="4,2" Background="{DynamicResource ChromeBrush}" TextTrimming="CharacterEllipsis" />
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><viewer:ViewerControl x:Name="LeftQuickView" /></Border>
            </DockPanel>
            <DockPanel x:Name="RightQuickHost" Grid.Column="2" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="Quick View  (Ctrl+Q to close)" Padding="4,3" Background="{DynamicResource PanelHeaderInactiveBrush}" Foreground="{DynamicResource PanelHeaderInactiveTextBrush}" FontWeight="SemiBold" />
                <TextBlock x:Name="RightQuickInfo" DockPanel.Dock="Bottom" Padding="4,2" Background="{DynamicResource ChromeBrush}" TextTrimming="CharacterEllipsis" />
                <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"><viewer:ViewerControl x:Name="RightQuickView" /></Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
