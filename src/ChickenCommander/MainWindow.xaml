<Window x:Class="ChickenCommander.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ChickenCommander.Views"
        Title="Chicken Commander" Icon="/Assets/chicken.ico"
        Width="1200" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ChromeBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewTextInput="Window_PreviewTextInput"
        Closing="Window_Closing">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource ChromeBrush}" Padding="2">
            <MenuItem Header="_Files">
                <MenuItem Header="_View" InputGestureText="F3" Command="{Binding ViewCommand}" />
                <MenuItem Header="_Edit" InputGestureText="F4" Command="{Binding EditCommand}" />
                <Separator />
                <MenuItem Header="_Copy..." InputGestureText="F5" Command="{Binding CopyCommand}" />
                <MenuItem Header="_Rename/Move..." InputGestureText="F6" Command="{Binding MoveCommand}" />
                <MenuItem Header="Re_name in place..." InputGestureText="Shift+F6" Command="{Binding RenameCommand}" />
                <MenuItem Header="New _folder..." InputGestureText="F7" Command="{Binding MakeDirectoryCommand}" />
                <MenuItem Header="_Delete" InputGestureText="F8 / Del" Command="{Binding DeleteCommand}" />
                <MenuItem Header="Delete _permanently" InputGestureText="Shift+Del" Command="{Binding DeletePermanentlyCommand}" />
                <Separator />
                <MenuItem Header="_Multi-Rename tool..." InputGestureText="Ctrl+M" Command="{Binding MultiRenameCommand}" />
                <MenuItem Header="Change _attributes..." InputGestureText="Ctrl+I" Command="{Binding ChangeAttributesCommand}" />
                <MenuItem Header="File _operations window" InputGestureText="Ctrl+Shift+O" Command="{Binding ShowOperationsCommand}" />
                <Separator />
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Mark">
                <MenuItem Header="_Select group..." InputGestureText="Num +" Command="{Binding SelectGroupCommand}" />
                <MenuItem Header="_Unselect group..." InputGestureText="Num -" Command="{Binding UnselectGroupCommand}" />
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="Unselect a_ll" InputGestureText="Ctrl+Shift+A" Command="{Binding UnselectAllCommand}" />
                <MenuItem Header="_Invert selection" InputGestureText="Num *" Command="{Binding InvertSelectionCommand}" />
            </MenuItem>
            <MenuItem Header="_Commands">
                <MenuItem Header="Directory _hotlist" InputGestureText="Ctrl+D" Command="{Binding ShowHotlistCommand}" />
                <MenuItem Header="Add current folder to hotlist..." Command="{Binding AddToHotlistCommand}" />
                <MenuItem Header="Folder hi_story" InputGestureText="Alt+Down" Command="{Binding ShowHistoryCommand}" />
                <MenuItem Header="_Back" InputGestureText="Alt+Left" Command="{Binding GoBackCommand}" />
                <MenuItem Header="_Forward" InputGestureText="Alt+Right" Command="{Binding GoForwardCommand}" />
                <Separator />
                <MenuItem Header="_Swap panels" InputGestureText="Ctrl+U" Command="{Binding SwapPanelsCommand}" />
                <MenuItem Header="_Target = Source" InputGestureText="Ctrl+E" Command="{Binding TargetEqualsSourceCommand}" />
                <MenuItem Header="Command _prompt here" Click="OpenCmd_Click" />
                <MenuItem Header="Open in _Explorer" Click="OpenExplorer_Click" />
            </MenuItem>
            <MenuItem Header="_Tabs">
                <MenuItem Header="_New tab" InputGestureText="Ctrl+T" Command="{Binding NewTabCommand}" />
                <MenuItem Header="Open folder in new _tab" InputGestureText="Ctrl+Up" Command="{Binding OpenInNewTabCommand}" />
                <MenuItem Header="_Close tab" InputGestureText="Ctrl+W" Command="{Binding CloseTabCommand}" />
                <MenuItem Header="Ne_xt tab" InputGestureText="Ctrl+Tab" Command="{Binding NextTabCommand}" />
                <MenuItem Header="_Previous tab" InputGestureText="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
            </MenuItem>
            <MenuItem Header="_Show">
                <MenuItem Header="_Hidden/system files" InputGestureText="Ctrl+H" IsCheckable="True"
                          IsChecked="{Binding ShowHidden, Mode=OneWay}" Command="{Binding ToggleHiddenCommand}" />
                <MenuItem Header="_Refresh" InputGestureText="Ctrl+R" Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" InputGestureText="F1" Click="Shortcuts_Click" />
                <MenuItem Header="_About Chicken Commander" Command="{Binding AboutCommand}" />
            </MenuItem>
        </Menu>

        <!-- Function key bar -->
        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="2">
            <UniformGrid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Margin" Value="1" />
                    <Setter Property="Padding" Value="4,3" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#C9CFDB" />
                </Style>
            </UniformGrid.Resources>
            <Button Content="F3 View" Command="{Binding ViewCommand}" />
            <Button Content="F4 Edit" Command="{Binding EditCommand}" />
            <Button Content="F5 Copy" Command="{Binding CopyCommand}" />
            <Button Content="F6 Move" Command="{Binding MoveCommand}" />
            <Button Content="F7 NewFolder" Command="{Binding MakeDirectoryCommand}" />
            <Button Content="F8 Delete" Command="{Binding DeleteCommand}" />
            <Button Content="Alt+F4 Exit" Click="Exit_Click" />
        </UniformGrid>

        <!-- Command line -->
        <DockPanel DockPanel.Dock="Bottom" Margin="4,2">
            <TextBlock Text="{Binding CommandPrompt}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#1B2A55"
                       MaxWidth="500" TextTrimming="CharacterEllipsis" />
            <TextBox x:Name="CommandLineBox" Text="{Binding CommandLine, UpdateSourceTrigger=PropertyChanged}"
                     Padding="2" KeyDown="CommandLineBox_KeyDown" />
        </DockPanel>

        <Grid Margin="2,2,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:FilePanel x:Name="LeftPanel" Grid.Column="0" DataContext="{Binding Left}" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False" />
            <views:FilePanel x:Name="RightPanel" Grid.Column="2" DataContext="{Binding Right}" />
        </Grid>
    </DockPanel>
</Window>
