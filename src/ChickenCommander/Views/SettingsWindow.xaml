<Window x:Class="ChickenCommander.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="820" Height="600" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/chicken.ico"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="90" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="90" IsCancel="True" />
        </StackPanel>

        <TabControl>
            <!-- Appearance -->
            <TabItem Header="Appearance">
                <StackPanel Margin="14" MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Theme" FontWeight="SemiBold" />
                    <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left" Margin="0,6,0,4">
                        <ComboBoxItem Content="Same as Windows" Tag="System" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                    </ComboBox>
                    <TextBlock Text="Preview: the change is applied when you press OK." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />

                    <TextBlock Text="File list font size" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Slider x:Name="FontSizeSlider" Minimum="10" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Width="220" />
                        <TextBlock Text="{Binding Value, ElementName=FontSizeSlider, StringFormat={}{0:0} pt}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <CheckBox x:Name="ButtonBarBox" Content="Show the button bar" Margin="0,18,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Operations -->
            <TabItem Header="Operations">
                <StackPanel Margin="14">
                    <CheckBox x:Name="RecycleBinBox" Content="Delete (F8 / Del) moves files to the _Recycle Bin" />
                    <TextBlock Text="Shift+Del always deletes permanently." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="22,2,0,0" />
                    <CheckBox x:Name="ConfirmDeleteBox" Content="_Ask before moving files to the Recycle Bin" Margin="0,12,0,0" />
                    <TextBlock Text="Permanent deletes and deletes on a server are always confirmed." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="22,2,0,0" />
                </StackPanel>
            </TabItem>

            <!-- Keyboard -->
            <TabItem Header="Keyboard">
                <DockPanel Margin="10">
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <TextBlock x:Name="SelectedCommandText" FontWeight="SemiBold" />
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock Text="Press the new shortcut:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="_Assign" Padding="10,2" Margin="8,0,0,0" Click="Assign_Click" ToolTip="Replace this command's shortcuts" />
                                    <Button Content="A_dd" Padding="10,2" Margin="6,0,0,0" Click="AddGesture_Click" ToolTip="Keep the existing shortcuts and add this one" />
                                    <Button Content="_Clear" Padding="10,2" Margin="6,0,0,0" Click="Clear_Click" ToolTip="No shortcut for this command" />
                                    <Button Content="_Reset" Padding="10,2" Margin="6,0,0,0" Click="ResetOne_Click" ToolTip="Back to the default" />
                                </StackPanel>
                                <TextBox x:Name="CaptureBox" IsReadOnly="True" Padding="3" PreviewKeyDown="CaptureBox_PreviewKeyDown"
                                         ToolTip="Click here and press a key combination" />
                            </DockPanel>
                            <TextBlock x:Name="ConflictText" Foreground="{DynamicResource MarkedBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Reset _all" Padding="10,2" Click="ResetAll_Click" />
                        <TextBox x:Name="FilterBox" Padding="3" TextChanged="FilterBox_TextChanged" ToolTip="Filter commands" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Enter, Backspace, Space and Esc keep their built-in meaning (they work with the command line)."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,6" />
                    <DataGrid x:Name="CommandsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" SelectionMode="Single" SelectionChanged="CommandsGrid_SelectionChanged"
                              Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100" />
                            <DataGridTextColumn Header="Command" Binding="{Binding Title}" Width="*" />
                            <DataGridTextColumn Header="Shortcut" Binding="{Binding GestureText}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Button bar -->
            <TabItem Header="Button bar">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Right" Width="170" Margin="10,0,0,0">
                        <Button Content="▲ Move _up" Click="Up_Click" Margin="0,0,0,4" />
                        <Button Content="▼ Move d_own" Click="Down_Click" Margin="0,0,0,4" />
                        <Button Content="_Remove" Click="Remove_Click" Margin="0,0,0,14" />
                        <Button Content="Add _separator" Click="AddSeparator_Click" Margin="0,0,0,4" />
                        <Button Content="Reset to _default" Click="ResetBar_Click" />
                    </StackPanel>
                    <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="10" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="4">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Add a command:" VerticalAlignment="Center" Width="120" />
                                <Button DockPanel.Dock="Right" Content="Add" Padding="12,2" Margin="8,0,0,0" Click="AddCommandButton_Click" />
                                <ComboBox x:Name="CommandPicker" DisplayMemberPath="Title" />
                            </DockPanel>
                            <TextBlock Text="Or a program:" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Program:" VerticalAlignment="Center" />
                                <TextBox x:Name="ProgramBox" Grid.Column="1" Padding="2" Margin="0,0,0,4" />
                                <Button Grid.Column="2" Content="…" Width="30" Margin="6,0,0,4" Click="BrowseProgram_Click" />
                                <TextBlock Grid.Row="1" Text="Arguments:" VerticalAlignment="Center" />
                                <TextBox x:Name="ArgumentsBox" Grid.Row="1" Grid.Column="1" Padding="2" Margin="0,0,0,4" Text="%F" />
                                <TextBlock Grid.Row="2" Text="Tooltip:" VerticalAlignment="Center" />
                                <TextBox x:Name="LabelBox" Grid.Row="2" Grid.Column="1" Padding="2" />
                                <Button Grid.Row="2" Grid.Column="2" Content="Add" Padding="12,2" Margin="6,0,0,0" Click="AddProgramButton_Click" />
                            </Grid>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="%P current folder · %N name under cursor · %F its full path · %S marked files · %T other panel's folder · %% a percent sign" />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="ButtonsList" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="26" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
