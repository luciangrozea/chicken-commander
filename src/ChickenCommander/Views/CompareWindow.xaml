<Window x:Class="ChickenCommander.Views.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="clr-namespace:ChickenCommander.Core.Tools;assembly=ChickenCommander.Core"
        Title="Compare by content" Width="1200" Height="760" MinWidth="700" MinHeight="400"
        WindowStartupLocation="CenterOwner" Icon="/Assets/chicken.ico"
        Background="{StaticResource ChromeBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <CheckBox x:Name="IgnoreCaseBox" Content="Ignore _case" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Option_Changed" Unchecked="Option_Changed" />
                <CheckBox x:Name="IgnoreSpaceBox" Content="Ignore _whitespace" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Option_Changed" Unchecked="Option_Changed" />
                <Button Content="▲ _Previous" Padding="10,2" Margin="0,0,6,0" Click="Previous_Click" ToolTip="Shift+F7" />
                <Button Content="▼ _Next" Padding="10,2" Margin="0,0,6,0" Click="Next_Click" ToolTip="F7" />
                <Button Content="⇄ _Swap" Padding="10,2" Click="Swap_Click" />
            </StackPanel>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" FontWeight="SemiBold" />
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LeftTitle" Foreground="#1B2A55" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="RightTitle" Grid.Column="1" Foreground="#1B2A55" TextTrimming="CharacterEllipsis" Margin="6,0,0,0" />
        </Grid>

        <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None"
                  GridLinesVisibility="None" BorderBrush="#C9CFDB" Background="White" RowHeight="19"
                  FontFamily="Cascadia Mono, Consolas" FontSize="12.5" SelectionMode="Extended"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False" CanUserResizeColumns="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static tools:DiffKind.Modified}">
                            <Setter Property="Background" Value="#FFF4D6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static tools:DiffKind.Deleted}">
                            <Setter Property="Background" Value="#FBE0E2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static tools:DiffKind.Inserted}">
                            <Setter Property="Background" Value="#DFF3E4" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="Black" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#C9D6EE" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding LeftNumber}" Width="52" Foreground="#8A90A0" />
                <DataGridTextColumn Binding="{Binding Left}" Width="*" />
                <DataGridTextColumn Binding="{Binding RightNumber}" Width="52" Foreground="#8A90A0" />
                <DataGridTextColumn Binding="{Binding Right}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
