<Window x:Class="ChickenCommander.Views.VerifyResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tools="clr-namespace:ChickenCommander.Core.Tools;assembly=ChickenCommander.Core"
        Title="Verify checksums" Width="760" Height="460" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Icon="/Assets/chicken.ico" Background="{StaticResource ChromeBrush}">
    <DockPanel Margin="12">
        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <Button DockPanel.Dock="Bottom" Content="Close" Width="80" HorizontalAlignment="Right" IsCancel="True" IsDefault="True" Margin="0,8,0,0" Click="Close_Click" />
        <DataGrid x:Name="Rows" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeight="20" BorderBrush="#C9CFDB" Background="White">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static tools:VerifyState.Mismatch}">
                            <Setter Property="Background" Value="#FBE0E2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static tools:VerifyState.Missing}">
                            <Setter Property="Background" Value="#FFF4D6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="{x:Static tools:VerifyState.Error}">
                            <Setter Property="Background" Value="#FFF4D6" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Result" Binding="{Binding State}" Width="80" />
                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                <DataGridTextColumn Header="Expected" Binding="{Binding Expected}" Width="200" FontFamily="Consolas" />
                <DataGridTextColumn Header="Actual / problem" Binding="{Binding Detail}" Width="200" FontFamily="Consolas" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
