<Window x:Class="ChickenCommander.Views.ChecksumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create checksums" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource ChromeBrush}">
    <StackPanel Margin="14">
        <TextBlock x:Name="MessageText" Margin="0,0,0,8" />
        <RadioButton x:Name="Sha256Box" Content="SHA-_256 (recommended)" IsChecked="True" Margin="0,2" />
        <RadioButton x:Name="Sha512Box" Content="SHA-_512" Margin="0,2" />
        <RadioButton x:Name="Sha1Box" Content="SHA-_1" Margin="0,2" />
        <RadioButton x:Name="Md5Box" Content="_MD5" Margin="0,2" />
        <RadioButton x:Name="CrcBox" Content="_CRC32 (.sfv)" Margin="0,2" />
        <CheckBox x:Name="OnePerFileBox" Content="One checksum _file per file" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
