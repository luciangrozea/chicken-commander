<UserControl x:Class="ChickenCommander.Views.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChickenCommander.ViewModels"
             x:Name="Root">
    <DockPanel>
        <!-- Drive selector + free space -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
            <ComboBox x:Name="DriveBox" Width="64" ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                      Focusable="False" ToolTip="Change drive (Alt+F1 / Alt+F2)" DropDownClosed="DriveBox_DropDownClosed">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DriveItem}">
                        <TextBlock Text="{Binding Letter}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding FreeSpaceText}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextMutedBrush}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Folder tabs (shown when there is more than one). × or middle-click closes a tab, right-click opens its menu. -->
        <ListBox x:Name="TabStrip" DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                 Focusable="False" BorderThickness="0" Background="Transparent" Margin="0,0,0,1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseDown="TabStrip_PreviewMouseDown" PreviewMouseUp="TabStrip_PreviewMouseUp">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tabs.Count}" Value="1">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="ToolTip" Value="{Binding Path}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Chip" Background="{DynamicResource TabBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1,1,1,0"
                                        CornerRadius="4,4,0,0" Padding="10,2,4,2" Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Label" Text="{Binding Title}" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                        <!-- Close button: clicks are handled in TabStrip_PreviewMouseDown (Tag="CloseTab") -->
                                        <Border x:Name="CloseButton" Tag="CloseTab" Background="Transparent" CornerRadius="3"
                                                Width="16" Height="16" Margin="6,0,0,0" VerticalAlignment="Center"
                                                ToolTip="Close tab (Ctrl+W, middle-click)" Opacity="0.45">
                                            <TextBlock Text="&#xE711;" FontFamily="{DynamicResource IconFont}" FontSize="9"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TabSelectedBrush}" />
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource CursorBrush}" />
                                        <Setter TargetName="CloseButton" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger SourceName="CloseButton" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseButton" Property="Background" Value="{DynamicResource AppBorderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Current path; highlighted on the active panel. Editable: type a path and press Enter. -->
        <TextBox x:Name="PathBox" DockPanel.Dock="Top" Text="{Binding CurrentPath, Mode=OneWay}" Padding="4,2"
                 BorderThickness="0" FontWeight="SemiBold" KeyDown="PathBox_KeyDown">
            <TextBox.Style>
                <Style TargetType="TextBox">
                    <Setter Property="Background" Value="{DynamicResource PanelHeaderInactiveBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PanelHeaderInactiveTextBrush}" />
                    <Setter Property="CaretBrush" Value="{DynamicResource PanelHeaderActiveTextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- Plain template: the Fluent text box adds borders and focus underlines that do not fit a header bar -->
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource PanelHeaderActiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource PanelHeaderActiveTextBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBox.Style>
        </TextBox>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Padding="4,2" Background="{DynamicResource ChromeBrush}"
                   TextTrimming="CharacterEllipsis" />

        <DataGrid x:Name="Grid"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding CurrentItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  CanUserReorderColumns="False" CanUserResizeRows="False" CanUserSortColumns="True"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  KeyboardNavigation.TabNavigation="Once"
                  BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}"
                  FontSize="{DynamicResource ListFontSize}" Foreground="{DynamicResource TextBrush}"
                  Sorting="Grid_Sorting"
                  MouseDoubleClick="Grid_MouseDoubleClick">
            <DataGrid.Resources>
                <!-- Cursor colours: strong on the active panel, faint on the inactive one -->
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource CursorColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource CursorTextColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource CursorInactiveColor}" />
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource CursorInactiveTextColor}" />
            </DataGrid.Resources>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Padding" Value="3,1" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- The cursor colour is painted on the cells: they span the whole row and nothing else overrides them -->
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource CursorBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource CursorInactiveBrush}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <!-- Own row template: the Fluent theme's row ignores Background, so the cursor colour would not show -->
                    <Setter Property="Template">
                        <Setter.Value>
                            <!-- DataGrid forces each row's Background from its RowBackground, so the cursor colour is set on this border instead -->
                            <ControlTemplate TargetType="DataGridRow">
                                <Border x:Name="RowBorder" Background="{DynamicResource SurfaceBrush}" SnapsToDevicePixels="True">
                                    <SelectiveScrollingGrid>
                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </SelectiveScrollingGrid.ColumnDefinitions>
                                        <SelectiveScrollingGrid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </SelectiveScrollingGrid.RowDefinitions>
                                        <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}"
                                                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                                                  SelectiveScrollingGrid.SelectiveScrollingOrientation="Horizontal" />
                                    </SelectiveScrollingGrid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                            <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CursorInactiveBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                                            <Condition Binding="{Binding DataContext.IsActive, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource CursorBrush}" />
                                    </MultiDataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <!-- Later triggers win: hidden < marked < cursor (inactive / active panel) < marked under cursor -->
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHidden}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource HiddenTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMarked}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource MarkedBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsActive, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource PanelHeaderActiveTextBrush}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMarked}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding DataContext.IsActive, ElementName=Root}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource MarkedCursorBrush}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="Name" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Ext" Binding="{Binding Ext}" Width="50" SortMemberPath="Ext" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="95" SortMemberPath="Size">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="115" SortMemberPath="Date" />
                <DataGridTextColumn Header="Attr" Binding="{Binding Attr}" Width="54" SortMemberPath="Attr" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
