<Window x:Class="ChickenCommander.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Chicken Commander" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource NavyBrush}">
    <StackPanel Margin="24">
        <Image Source="/Assets/chicken.png" Width="128" Height="128" />
        <TextBlock Text="Chicken Commander" FontSize="24" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" Margin="0,14,0,0" />
        <TextBlock x:Name="VersionText" Foreground="{DynamicResource OrangeBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
        <TextBlock Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                   Text="A keyboard-driven, dual-pane file manager for Windows, built with C# and WPF. Inspired by the classic orthodox file managers." />
        <Button Content="OK" Width="90" IsDefault="True" IsCancel="True" Margin="0,20,0,0" Click="Ok_Click" />
    </StackPanel>
</Window>
