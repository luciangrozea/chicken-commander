<Window x:Class="ChickenCommander.Views.MultiRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ChickenCommander.ViewModels"
        Title="Multi-Rename Tool" Width="900" Height="620" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/chicken.ico"
        Background="{DynamicResource ChromeBrush}">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="2" />
        </Style>
        <Style x:Key="Tag" TargetType="Button">
            <Setter Property="Margin" Value="0,4,4,0" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Command" Value="{Binding InsertPlaceholderCommand}" />
            <Setter Property="CommandParameter" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="Rename mask: file name" Grid.Column="0">
                <StackPanel>
                    <TextBox x:Name="NameMaskBox" Text="{Binding NameMask, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel>
                        <Button Style="{StaticResource Tag}" Content="[N]" ToolTip="Name" />
                        <Button Style="{StaticResource Tag}" Content="[N1-3]" ToolTip="Characters 1 to 3 of the name" />
                        <Button Style="{StaticResource Tag}" Content="[C]" ToolTip="Counter" />
                        <Button Style="{StaticResource Tag}" Content="[YMD]" ToolTip="Date yyyyMMdd" />
                        <Button Style="{StaticResource Tag}" Content="[h][m][s]" ToolTip="Time" />
                        <Button Style="{StaticResource Tag}" Content="[P]" ToolTip="Parent folder" />
                        <Button Style="{StaticResource Tag}" Content="[E]" ToolTip="Extension" />
                    </WrapPanel>
                    <TextBlock Text="Extension" Margin="0,8,0,2" />
                    <TextBox Text="{Binding ExtensionMask, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Search &amp; replace" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Search for" Margin="0,0,0,2" />
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Replace with" Margin="0,6,0,2" />
                    <TextBox Text="{Binding Replace, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <CheckBox Content="Regular expressions" IsChecked="{Binding UseRegex}" Margin="0,0,12,0" />
                        <CheckBox Content="Match case" IsChecked="{Binding MatchCase}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Grid.Column="2">
                <GroupBox Header="Upper / lower case" Margin="0,0,0,8">
                    <ComboBox ItemsSource="{Binding CaseModes}" SelectedItem="{Binding CaseMode}" />
                </GroupBox>
                <GroupBox Header="Counter [C]" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Start at" VerticalAlignment="Center" Margin="0,0,8,2" />
                        <TextBox Grid.Column="1" Text="{Binding CounterStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2" />
                        <TextBlock Grid.Row="1" Text="Step by" VerticalAlignment="Center" Margin="0,0,8,2" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CounterStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2" />
                        <TextBlock Grid.Row="2" Text="Digits" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CounterDigits, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Reset" Width="80" Command="{Binding ResetCommand}" Margin="0,0,8,0" />
                <Button Content="Undo" Width="80" Command="{Binding UndoCommand}" Margin="0,0,8,0" />
                <Button Content="Start!" Width="90" Command="{Binding StartCommand}" FontWeight="Bold" Margin="0,0,8,0" />
                <Button Content="Close" Width="80" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Previews}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="20"
                  BorderBrush="{DynamicResource AppBorderBrush}" Background="{DynamicResource SurfaceBrush}" CanUserSortColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Changes}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Error, Converter={x:Static vm:NotNullConverter.Instance}}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource MarkedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Old name" Binding="{Binding OldName}" Width="*" />
                <DataGridTextColumn Header="New name" Binding="{Binding NewName}" Width="*" />
                <DataGridTextColumn Header="Problem" Binding="{Binding Error}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
