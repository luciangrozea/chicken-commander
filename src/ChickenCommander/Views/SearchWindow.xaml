<Window x:Class="ChickenCommander.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find files" Width="860" Height="640" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" Icon="/Assets/chicken.ico" ShowInTaskbar="False"
        Background="{StaticResource ChromeBrush}" PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,10,6" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="Search _for:" />
            <TextBox x:Name="MaskBox" Grid.Column="1" Text="*.*" ToolTip="Masks separated by ; — e.g. *.cs;*.xaml | bin*" />
            <CheckBox x:Name="SubfoldersBox" Grid.Column="2" Content="Sub_folders" IsChecked="True" Margin="10,0,0,6" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="Search _in:" />
            <TextBox x:Name="FolderBox" Grid.Row="1" Grid.Column="1" />
            <CheckBox x:Name="HiddenBox" Grid.Row="1" Grid.Column="2" Content="_Hidden files" Margin="10,0,0,6" VerticalAlignment="Center" />

            <TextBlock Grid.Row="2" Text="_Containing text:" />
            <TextBox x:Name="ContainsBox" Grid.Row="2" Grid.Column="1" />
            <CheckBox x:Name="MatchCaseBox" Grid.Row="2" Grid.Column="2" Content="_Match case" Margin="10,0,0,6" VerticalAlignment="Center" />

            <TextBlock Grid.Row="3" Text="Size (KB):" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="at least" Margin="0,0,6,0" />
                <TextBox x:Name="MinSizeBox" Width="90" Margin="0" />
                <TextBlock Text="at most" Margin="14,0,6,0" />
                <TextBox x:Name="MaxSizeBox" Width="90" Margin="0" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Modified:" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="after" Margin="0,0,6,0" />
                <DatePicker x:Name="AfterBox" Width="130" />
                <TextBlock Text="before" Margin="14,0,6,0" />
                <DatePicker x:Name="BeforeBox" Width="130" />
            </StackPanel>
        </Grid>

        <DockPanel DockPanel.Dock="Top" Margin="0,4,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="StartButton" Content="_Start search" Width="110" IsDefault="True" Click="Start_Click" Margin="0,0,8,0" />
                <Button x:Name="StopButton" Content="Sto_p" Width="80" Click="Stop_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#5A6275" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Go to file" Width="100" Click="GoTo_Click" Margin="0,0,8,0" />
                <Button Content="_View (F3)" Width="100" Click="View_Click" Margin="0,0,8,0" />
                <Button Content="Close" Width="80" IsCancel="True" Click="Close_Click" />
            </StackPanel>
            <TextBlock Text="Enter or double-click: go to file" VerticalAlignment="Center" Foreground="#5A6275" FontSize="11" />
        </DockPanel>

        <DataGrid x:Name="Results" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" RowHeight="20" BorderBrush="#C9CFDB" Background="White"
                  SelectionMode="Single" MouseDoubleClick="Results_MouseDoubleClick"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Entry.Name}" Width="220" />
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="*" />
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Date" Binding="{Binding Entry.Modified, StringFormat=dd.MM.yyyy HH:mm}" Width="115" />
                <DataGridTextColumn Header="Match" Binding="{Binding MatchText}" Width="200" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
