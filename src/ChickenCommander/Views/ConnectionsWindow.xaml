<Window x:Class="ChickenCommander.Views.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to server" Width="720" Height="470" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="/Assets/chicken.ico"
        Background="{StaticResource ChromeBrush}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="_Connect" Width="100" IsDefault="True" Click="Connect_Click" FontWeight="Bold" Margin="0,0,8,0" />
                <Button Content="Close" Width="80" IsCancel="True" />
            </StackPanel>
            <TextBlock Text="Passwords are saved encrypted for your Windows account (DPAPI), only if you tick “Save password”."
                       Foreground="#5A6275" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Left" Width="210" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="_New" Width="66" Click="New_Click" Margin="0,0,6,0" />
                <Button Content="_Delete" Width="66" Click="Delete_Click" />
            </StackPanel>
            <ListBox x:Name="List" DisplayMemberPath="Name" SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,10,8" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Padding" Value="2" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </Grid.Resources>

            <TextBlock Text="_Name:" />
            <TextBox x:Name="NameBox" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="_Protocol:" />
            <ComboBox x:Name="ProtocolBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="Protocol_Changed">
                <ComboBoxItem Content="SFTP (SSH)" />
                <ComboBoxItem Content="FTP" />
                <ComboBoxItem Content="FTPS (FTP over TLS, explicit)" />
            </ComboBox>
            <TextBlock Grid.Row="2" Text="_Host:" />
            <TextBox x:Name="HostBox" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="3" Text="P_ort:" />
            <TextBox x:Name="PortBox" Grid.Row="3" Grid.Column="1" Width="80" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="4" Text="_User:" />
            <TextBox x:Name="UserBox" Grid.Row="4" Grid.Column="1" />
            <TextBlock Grid.Row="5" Text="Pass_word:" />
            <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="PasswordBox" Padding="2" />
                <CheckBox x:Name="SavePasswordBox" Grid.Column="1" Content="_Save password" VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
            <TextBlock Grid.Row="6" Text="_Key file (SFTP):" />
            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="…" Width="30" Margin="6,0,0,0" Click="BrowseKey_Click" />
                <TextBox x:Name="KeyBox" Margin="0" ToolTip="Optional private key (OpenSSH / PuTTY format). The password above is then the key's passphrase." />
            </DockPanel>
            <TextBlock Grid.Row="7" Text="Start _folder:" />
            <TextBox x:Name="FolderBox" Grid.Row="7" Grid.Column="1" Text="/" />
            <TextBlock x:Name="FingerprintText" Grid.Row="8" Grid.ColumnSpan="2" Foreground="#5A6275" FontSize="11" TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</Window>
