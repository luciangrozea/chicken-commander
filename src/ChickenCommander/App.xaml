<Application x:Class="ChickenCommander.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Brand colours taken from the chicken logo -->
        <Color x:Key="NavyColor">#1B2A55</Color>
        <Color x:Key="OrangeColor">#F7A51C</Color>
        <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
        <SolidColorBrush x:Key="OrangeBrush" Color="{StaticResource OrangeColor}" />
        <SolidColorBrush x:Key="PanelHeaderInactiveBrush" Color="#D9DEE8" />
        <SolidColorBrush x:Key="CursorBrush" Color="#2F5AA8" />
        <SolidColorBrush x:Key="CursorInactiveBrush" Color="#E3E7EF" />
        <SolidColorBrush x:Key="MarkedBrush" Color="#D11F2E" />
        <SolidColorBrush x:Key="ChromeBrush" Color="#F3F4F7" />
    </Application.Resources>
</Application>
