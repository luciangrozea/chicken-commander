<Application x:Class="ChickenCommander.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The colour dictionary (Light or Dark) is swapped at runtime by ThemeManager. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <!-- File list font size; replaced at runtime from the settings -->
            <sys:Double x:Key="ListFontSize">13</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
