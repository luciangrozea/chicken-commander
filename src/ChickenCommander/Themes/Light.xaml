<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme. Every colour the app uses has a key here and in Dark.xaml; XAML refers to them with DynamicResource. -->
    <Color x:Key="CursorColor">#2F5AA8</Color>
    <Color x:Key="CursorTextColor">White</Color>
    <Color x:Key="CursorInactiveColor">#DCE3F0</Color>
    <Color x:Key="CursorInactiveTextColor">Black</Color>

    <SolidColorBrush x:Key="TextBrush" Color="#1F2430" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6275" />
    <SolidColorBrush x:Key="HiddenTextBrush" Color="#8A90A0" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1B2A55" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="White" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#F3F4F7" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#C9CFDB" />
    <SolidColorBrush x:Key="PanelHeaderActiveBrush" Color="#1B2A55" />
    <SolidColorBrush x:Key="PanelHeaderActiveTextBrush" Color="White" />
    <SolidColorBrush x:Key="PanelHeaderInactiveBrush" Color="#D9DEE8" />
    <SolidColorBrush x:Key="PanelHeaderInactiveTextBrush" Color="#1B2A55" />
    <SolidColorBrush x:Key="TabBrush" Color="#E3E7EF" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="White" />
    <SolidColorBrush x:Key="CursorBrush" Color="#2F5AA8" />
    <SolidColorBrush x:Key="CursorInactiveBrush" Color="#DCE3F0" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E3E7EF" />
    <SolidColorBrush x:Key="MarkedBrush" Color="#D11F2E" />
    <SolidColorBrush x:Key="MarkedCursorBrush" Color="#F7A51C" />
    <SolidColorBrush x:Key="NavyBrush" Color="#1B2A55" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#F7A51C" />
    <SolidColorBrush x:Key="CardBrush" Color="White" />
    <SolidColorBrush x:Key="DiffModifiedBrush" Color="#FFF4D6" />
    <SolidColorBrush x:Key="DiffDeletedBrush" Color="#FBE0E2" />
    <SolidColorBrush x:Key="DiffInsertedBrush" Color="#DFF3E4" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#C9D6EE" />
    <SolidColorBrush x:Key="ImageBackdropBrush" Color="#2B2F3A" />
</ResourceDictionary>
