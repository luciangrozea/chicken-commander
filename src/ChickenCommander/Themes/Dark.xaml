<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: same keys as Light.xaml. Navy and orange from the logo stay as accents. -->
    <Color x:Key="CursorColor">#3B6FD0</Color>
    <Color x:Key="CursorTextColor">White</Color>
    <Color x:Key="CursorInactiveColor">#2E3445</Color>
    <Color x:Key="CursorInactiveTextColor">#E6E9F0</Color>

    <SolidColorBrush x:Key="TextBrush" Color="#E6E9F0" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA3B5" />
    <SolidColorBrush x:Key="HiddenTextBrush" Color="#6E7689" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#F7B84A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1F27" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#252934" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3A4152" />
    <SolidColorBrush x:Key="PanelHeaderActiveBrush" Color="#2F4A8A" />
    <SolidColorBrush x:Key="PanelHeaderActiveTextBrush" Color="White" />
    <SolidColorBrush x:Key="PanelHeaderInactiveBrush" Color="#2E3445" />
    <SolidColorBrush x:Key="PanelHeaderInactiveTextBrush" Color="#C3CAD8" />
    <SolidColorBrush x:Key="TabBrush" Color="#2A2F3B" />
    <SolidColorBrush x:Key="TabSelectedBrush" Color="#1C1F27" />
    <SolidColorBrush x:Key="CursorBrush" Color="#3B6FD0" />
    <SolidColorBrush x:Key="CursorInactiveBrush" Color="#2E3445" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#323848" />
    <SolidColorBrush x:Key="MarkedBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="MarkedCursorBrush" Color="#FFC857" />
    <SolidColorBrush x:Key="NavyBrush" Color="#2F4A8A" />
    <SolidColorBrush x:Key="OrangeBrush" Color="#F7A51C" />
    <SolidColorBrush x:Key="CardBrush" Color="#1C1F27" />
    <SolidColorBrush x:Key="DiffModifiedBrush" Color="#4A3F1E" />
    <SolidColorBrush x:Key="DiffDeletedBrush" Color="#4F2428" />
    <SolidColorBrush x:Key="DiffInsertedBrush" Color="#1F4229" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#2F4A8A" />
    <SolidColorBrush x:Key="ImageBackdropBrush" Color="#14161C" />
</ResourceDictionary>
