<Window x:Class="ChickenCommander.Viewer.ListerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="clr-namespace:ChickenCommander.Viewer"
        Title="Lister" Width="1000" Height="700" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" Icon="/Assets/chicken.ico"
        Background="{StaticResource ChromeBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel>
        <!-- Toolbar -->
        <DockPanel DockPanel.Dock="Top" Margin="6,6,6,4">
            <StackPanel Orientation="Horizontal">
                <StackPanel.Resources>
                    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                        <Setter Property="Padding" Value="10,2" />
                        <Setter Property="Margin" Value="0,0,2,0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </StackPanel.Resources>
                <RadioButton x:Name="TextMode" Content="_1 Text" Checked="Mode_Checked" ToolTip="Text (1)" />
                <RadioButton x:Name="HexMode" Content="_2 Hex" Checked="Mode_Checked" ToolTip="Hex (2)" />
                <RadioButton x:Name="ImageMode" Content="_3 Image" Checked="Mode_Checked" ToolTip="Image (3)" />
                <CheckBox x:Name="WrapBox" Content="_Wrap" VerticalAlignment="Center" Margin="12,0,0,0" Focusable="False"
                          Checked="Wrap_Changed" Unchecked="Wrap_Changed" ToolTip="Word wrap (W)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Find:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="FindBox" Width="200" Padding="2" KeyDown="FindBox_KeyDown" ToolTip="Ctrl+F, then Enter / F3 for next" />
                <CheckBox x:Name="MatchCaseBox" Content="Aa" VerticalAlignment="Center" Margin="6,0" Focusable="False" ToolTip="Match case" />
                <Button Content="Next" Padding="10,1" Click="FindNext_Click" Focusable="False" />
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <DockPanel DockPanel.Dock="Bottom" Margin="6,2">
            <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Foreground="#5A6275" />
            <TextBlock x:Name="InfoText" Foreground="#5A6275" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border BorderBrush="#C9CFDB" BorderThickness="0,1">
            <viewer:ViewerControl x:Name="Viewer" />
        </Border>
    </DockPanel>
</Window>
