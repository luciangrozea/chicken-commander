<UserControl x:Class="ChickenCommander.Viewer.ViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewer="clr-namespace:ChickenCommander.Viewer"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <!-- Small text files: a real text box, so text can be selected and copied -->
        <TextBox x:Name="TextView" IsReadOnly="True" IsReadOnlyCaretVisible="True" BorderThickness="0"
                 FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="6,4"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 AcceptsReturn="True" Visibility="Collapsed" />

        <!-- Large text files and hex view: only visible rows are read from disk -->
        <ListBox x:Name="LinesView" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 SelectionMode="Extended" Visibility="Collapsed" KeyDown="LinesView_KeyDown">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type viewer:ViewerLine}">
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <ScrollViewer x:Name="ImageView" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource ImageBackdropBrush}">
            <Image x:Name="ImageControl" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
        </ScrollViewer>

        <TextBlock x:Name="MessageView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap" Margin="20" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" />
    </Grid>
</UserControl>
